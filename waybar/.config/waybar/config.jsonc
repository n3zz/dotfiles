{
  "layer": "top",
  "position": "top",
  "height": 30,

  "modules-left": [
    "hyprland/workspaces",
    "custom/prev",
    "custom/play-pause",
    "custom/next",
    "mpris",
  ],
  "modules-center": ["clock"],
  "modules-right": [
    "idle_inhibitor",
    "cpu",
    "memory",
    "temperature",
    "network",
    "pulseaudio",
    "battery",
    "tray",
  ],

  "custom/prev": {
    "format": "",
    "on-click": "playerctl previous",
    "tooltip": false,
  },

  "custom/play-pause": {
    "format": "",
    "exec": "playerctl status 2>/dev/null | grep -q Playing && echo '' || echo ''",
    "interval": 1,
    "on-click": "playerctl play-pause",
    "tooltip": false,
  },

  "custom/next": {
    "format": "",
    "on-click": "playerctl next",
    "tooltip": false,
  },

  "mpris": {
    "format": "{title} - {artist} {position}/{length}",
    "format-paused": "<i>{title} - {artist} {position}/{length}</i>",
    "dynamic-order": ["title", "artist", "position", "length"],
    "interval": 1,
    "max-length": 40,
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d %B %Y, %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "today": "<span color='#ffffff'><b>{}</b></span>",
      },
    },
    "actions": {
      "on-click": "mode",
    },
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": "",
    },
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2,
  },

  "memory": {
    "format": " {percentage}%",
    "interval": 2,
  },

  "temperature": {
    "format": " {temperatureC}°C",
    "critical-threshold": 80,
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " Connected",
    "format-disconnected": "⚠ Disconnected",
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-icons": ["", "", ""],
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""],
  },

  "tray": {
    "spacing": 8,
  },
}
