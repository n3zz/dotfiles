@import "/home/ary/.cache/wal/colors-rofi-vars.rasi"

configuration {
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 640px;
    border: 1px;
    border-radius: 20px;
    border-color: @line;
    background-color: @surface;
}
mainbox { children: [ inputbar, listview ]; spacing: 0; }
inputbar {
    padding: 20px 22px;
    spacing: 14px;
    border: 0 0 1px 0;
    border-color: @line;
    children: [ prompt, entry ];
}
prompt { str: ""; text-color: @muted; font: "JetBrainsMono Nerd Font 16"; }
entry  {
    placeholder: "Search";
    placeholder-color: @muted;
    font: "JetBrainsMono Nerd Font 16";
    vertical-align: 0.5;
}
listview {
    padding: 10px;
    lines: 7;
    spacing: 2px;
    scrollbar: false;
    fixed-height: false;
}
element {
    padding: 10px 14px;
    spacing: 14px;
    border-radius: 12px;
    border: 0;
    border-color: transparent;
}
element selected { background-color: @sel; }
element-icon { size: 30px; }
element-text { vertical-align: 0.5; }
element-text selected { text-color: @fg; }
