# Replay buffer for clipping (read by gpu-screen-recorder.service)
WINDOW=DP-4
FRAMERATE=60
REPLAYDURATION=60
QUALITY=40000
CODEC=auto
# desktop sound + mic mixed into one track (so clips sound right in Discord etc.)
AUDIO_DEVICE=default_output|default_input
OUTPUTDIR=/home/ary/Videos/Clips
ADDITIONAL_ARGS=-sc /home/ary/.config/hypr/scripts/clip-saved.sh
